{
  "expo": {
    "name": "Solis",
    "slug": "solis-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "solis",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-system-ui",
      "expo-dev-client"
    ],
    "android": {
      "package": "com.solis.mobile",
      "newArchEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "bundleIdentifier": "com.solis.mobile"
    }
  }
}
